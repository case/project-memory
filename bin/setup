#!/usr/bin/env bash
# Verify the environment, install the pinned dev tools

set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v python3 >/dev/null 2>&1; then
    echo "Error: python3 not found on PATH" >&2
    exit 1
fi

python3 - <<'PY'
import sys
v = sys.version_info
if v < (3, 10):
    print(f"Error: Python 3.10+ required, found {v[0]}.{v[1]}", file=sys.stderr)
    sys.exit(1)
print(f"✅ python3 {v[0]}.{v[1]}.{v[2]} is installed")
PY

if command -v uv >/dev/null 2>&1; then
    echo "==> uv sync (installing pinned dev tools: ruff, shellcheck, pymarkdown)"
    uv sync --locked
    echo "✅ dev tools installed"
else
    echo "⚠️  uv not found - install it (mise, or https://docs.astral.sh/uv/)" >&2
    echo "   so bin/lint can run the pinned linters." >&2
fi

if [[ -d .git ]]; then
    git config core.hooksPath .githooks
    echo "✅ git hooks wired (.githooks/pre-commit, .githooks/pre-push)"
fi

echo
echo "✅ Environment OK."
