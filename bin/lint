#!/usr/bin/env bash
# Linters are version-pinned in pyproject.toml and run through uv

set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v uv >/dev/null 2>&1; then
    echo "Error: uv not found on PATH." >&2
    echo "Install it via mise or https://docs.astral.sh/uv/, then re-run." >&2
    exit 1
fi

# --locked uses the exact versions from uv.lock
echo "==> ruff check"
uv run --locked ruff check init tests | sed 's/^All checks passed!$/✅ All checks passed!/'

echo "==> ruff format --check"
uv run --locked ruff format --check init tests

echo "==> shellcheck"
uv run --locked shellcheck bin/*

# PyMarkdown reads [tool.pymarkdown] from pyproject.toml
echo "==> pymarkdown"
uv run --locked pymarkdown --strict-config scan --respect-gitignore -r .

# dprint is not pinned through uv, so it runs only where installed. CI skips it.
if command -v dprint >/dev/null 2>&1; then
    echo "==> dprint check"
    dprint check
else
    echo "==> dprint check (skipped: dprint not installed)"
fi

echo
echo "✅ Lint passed."
